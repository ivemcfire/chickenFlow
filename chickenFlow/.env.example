# Local development environment variables.
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4000
DB_PATH=./chickenflow.db
CAPTURES_DIR=./data/captures

# MQTT broker (ESP32 firmware uses the LB IP; backend inside k3s uses cluster DNS)
MQTT_URL=mqtt://192.168.100.207:1883
COOP_TZ=Europe/Sofia

# Ollama (local LLM for telemetry analysis)
OLLAMA_URL=http://ollama.chickenflow.svc.cluster.local:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
